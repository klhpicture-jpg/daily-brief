# Copy to .env for local runs. In GitHub Actions these are repository secrets.
OPENAI_API_KEY=
FIRECRAWL_API_KEY=
APIFY_TOKEN=

# telegram (default), sms or whatsapp. See README for setup.
DELIVERY_CHANNEL=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Only for sms or whatsapp.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX
TWILIO_TO=+45XXXXXXXX
# Only for whatsapp: the approved Content Template SID (HX...).
TWILIO_CONTENT_SID=

# Model IDs. Run scripts/check_models.py and pick from what exists.
OPENAI_RANK_MODEL=gpt-5-nano
OPENAI_WRITE_MODEL=gpt-5
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Where the pages are published. Defaults to the GitHub Pages URL of this repo.
PAGES_BASE_URL=https://klhpicture-jpg.github.io/daily-brief
GITHUB_REPOSITORY=klhpicture-jpg/daily-brief
